#!/usr/bin/env bash
set -euo pipefail

usage() { echo "usage: ota-push <node-id|all> <firmware.bin>"; exit 1; }
[[ $# -eq 2 ]] || usage
TARGET=$1
BIN=$2

CONF="$HOME/.config/iothub/mqtt.env"
FW_DIR="$HOME/firmware"
FW_PORT=${FW_PORT:-8000}
TIMEOUT=${OTA_TIMEOUT:-150}

[[ -f $CONF ]] || { echo "missing $CONF - run setup-ota.sh first"; exit 1; }
source "$CONF"
M=(-h localhost -u "$MQTT_USER" -P "$MQTT_PASS")

[[ -f $BIN ]] || { echo "no such file: $BIN"; exit 1; }
case "$(basename "$BIN")" in
  *merged*|*bootloader*|*partitions*)
    echo "use the app image (<sketch>.ino.bin), not the merged/bootloader/partitions file"; exit 1;;
esac
[[ $(od -An -tx1 -N1 "$BIN" | tr -d ' \n') == e9 ]] || { echo "$BIN is not an ESP32 firmware image"; exit 1; }

mapfile -t ONLINE < <(timeout 2 mosquitto_sub "${M[@]}" -v -t 'home/+/status' 2>/dev/null \
  | awk '$2=="online"{split($1,a,"/"); if (a[2]!="hub") print a[2]}' | sort -u || true)

if [[ $TARGET == all ]]; then
  NODES=("${ONLINE[@]}")
  [[ ${#NODES[@]} -gt 0 ]] || { echo "no nodes online"; exit 1; }
else
  if ! printf '%s\n' "${ONLINE[@]}" | grep -qx "$TARGET"; then
    echo "node '$TARGET' is not online. Online nodes: ${ONLINE[*]:-(none)}"; exit 1
  fi
  NODES=("$TARGET")
fi

mkdir -p "$FW_DIR"
NAME="fw-$(date +%Y%m%d-%H%M%S).bin"
install -m 644 "$BIN" "$FW_DIR/$NAME"
ls -1t "$FW_DIR"/fw-*.bin 2>/dev/null | tail -n +6 | xargs -r rm -f
curl -fsI "http://localhost:$FW_PORT/$NAME" >/dev/null || { echo "firmware server not running (systemctl status iothub-firmware)"; exit 1; }

echo "Firmware $(du -h "$BIN" | cut -f1) -> ${NODES[*]}"

exec 3< <(timeout "$TIMEOUT" mosquitto_sub "${M[@]}" -v -t 'home/+/ota/status')
SUB_PID=$!
sleep 0.5

for n in "${NODES[@]}"; do
  info=$(mosquitto_sub "${M[@]}" -t "home/$n/info" -C 1 -W 3 2>/dev/null || true)
  node_ip=$(grep -o '"ip":"[^"]*"' <<<"$info" | cut -d'"' -f4)
  host_ip=$(ip route get "${node_ip:-1.1.1.1}" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
  [[ -n $host_ip ]] || { echo "  $n: can't work out a route to ${node_ip:-?}, skipped"; continue; }
  url="http://$host_ip:$FW_PORT/$NAME"
  echo "  $n ($node_ip) <- $url"
  mosquitto_pub "${M[@]}" -t "home/$n/cmd" -m "ota $url"
done

finished=" "
ok=0; failed=0
while read -r -u 3 t msg; do
  n=$(cut -d/ -f2 <<<"$t")
  printf '%s\n' "${NODES[@]}" | grep -qx "$n" || continue
  echo "[$(date +%T)] $n: $msg"
  case $msg in
    booted*) [[ $finished == *" $n "* ]] || { finished+="$n "; ok=$((ok+1)); };;
    failed*) [[ $finished == *" $n "* ]] || { finished+="$n "; failed=$((failed+1)); };;
  esac
  (( ok + failed >= ${#NODES[@]} )) && break
done
kill "$SUB_PID" 2>/dev/null || true

echo "Updated: $ok   Failed: $failed   No answer: $(( ${#NODES[@]} - ok - failed ))"
[[ $ok -eq ${#NODES[@]} ]]
